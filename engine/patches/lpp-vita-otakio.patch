+	lua_pushvalue(L, 2);
+	lua_rawseti(L, 5, 2);
+	lua_pushvalue(L, 3);
+	lua_rawseti(L, 5, 3);
+	lua_newtable(L);
+	lua_rawseti(L, 5, 4);
+	lua_newtable(L);
+	lua_rawseti(L, 5, 5);
